# --- Mailbox (Gmail: enable 2FA, then create an App Password) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=you@gmail.com
IMAP_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Optional extra mailboxes (copy this pair for _3, _4 ...) ---
# IMAP_USER_2=second@gmail.com
# IMAP_APP_PASSWORD_2=xxxxxxxxxxxxxxxx

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- What to forward ---
# true  = every new email (sender, subject, short preview)
# false = only OTP emails from ALLOWED_SENDERS
FORWARD_ALL=true
ALLOWED_SENDERS=you@gmail.com

# Never forward these senders (comma-separated, no spaces), e.g. noisy newsletters
BLOCKED_SENDERS=
# Characters of email body to include. 0 = sender + subject only (more private)
SNIPPET_CHARS=500
# Gmail only: true = skip Promotions/Social/Updates tabs
GMAIL_PRIMARY_ONLY=false

# --- Tuning ---
POLL_SECONDS=10
FORWARD_MAX_AGE_MINUTES=120
MAX_MESSAGES_PER_HOUR=60
